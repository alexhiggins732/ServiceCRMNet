@page "/ai-assistant"
@inject ISnackbar Snackbar
@inject CrmApiClient ApiClient

<PageTitle>AI Assistant</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">AI Assistant</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudSelect T="string" @bind-Value="selectedProvider" Label="AI Provider" Variant="Variant.Outlined" Class="mb-4" Style="max-width: 300px;">
        <MudSelectItem Value="@("OpenAI")">OpenAI (ChatGPT)</MudSelectItem>
        <MudSelectItem Value="@("Gemini")">Google Gemini</MudSelectItem>
        <MudSelectItem Value="@("Grok")">xAI Grok</MudSelectItem>
    </MudSelect>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4" Style="height: 400px; overflow-y: auto; background-color: #f5f5f5;">
        @foreach (var msg in chatHistory)
        {
            <div class="mb-3 d-flex @(msg.IsUser ? "justify-end" : "justify-start")">
                <MudPaper Elevation="1" Class="pa-3" Style="@(msg.IsUser ? "background-color: #e3f2fd; max-width: 80%;" : "background-color: #ffffff; max-width: 80%;")">
                    <MudText>@msg.Text</MudText>
                </MudPaper>
            </div>
        }
        @if(isThinking)
        {
             <div class="mb-3 justify-start">
                 <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
             </div>
        }
    </MudPaper>

    <div class="d-flex gap-2">
        <MudTextField @bind-Value="prompt" Placeholder="Type your message..." Variant="Variant.Outlined" Lines="2" Immediate="true" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendMessage" Disabled="@(string.IsNullOrWhiteSpace(prompt) || isThinking)">
            Send
        </MudButton>
    </div>
</MudPaper>

@code {
    private string selectedProvider = "OpenAI";
    private string prompt = "";
    private bool isThinking = false;
    private List<ChatMessage> chatHistory = new()
    {
        new ChatMessage { IsUser = false, Text = "Hello! I'm your Garage Door CRM Assistant. How can I help you today?" }
    };

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(prompt)) return;

        chatHistory.Add(new ChatMessage { IsUser = true, Text = prompt });
        var currentPrompt = prompt;
        prompt = "";
        isThinking = true;
        StateHasChanged();

        try
        {
            var response = await ApiClient.SendAiMessageAsync(selectedProvider, currentPrompt);
            chatHistory.Add(new ChatMessage { IsUser = false, Text = response });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"AI Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isThinking = false;
            StateHasChanged();
        }
    }

    private class ChatMessage
    {
        public bool IsUser { get; set; }
        public string Text { get; set; } = "";
    }
}

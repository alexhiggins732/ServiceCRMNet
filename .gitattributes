# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

#
# The above will handle all files NOT found below
#
# These files are text and should be normalized (Convert crlf => lf)
*.c           text
*.cpp         text
*.cs          text diff=csharp
*.css         text
*.gitattributes text
*.gitignore   text
*.htm         text
*.html        text
*.ini         text
*.java        text
*.js          text
*.json        text
*.md          text
*.php         text
*.pl          text
*.ps1         text eol=crlf
*.py          text
*.rb          text
*.sass        text
*.scss        text
*.sh          text eol=lf
*.sln         text eol=crlf
*.sql         text
*.ts          text
*.txt         text
*.vb          text
*.xml         text
*.yml         text

# These files are binary and should be left untouched
# (binary is a macro for -text -diff)
*.class       binary
*.dll         binary
*.ear         binary
*.gif         binary
*.ico         binary
*.jar         binary
*.jpg         binary
*.jpeg        binary
*.png         binary
*.so          binary
*.war         binary
